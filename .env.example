# Secrets and per-host overrides for blockbustr. Copy to .env (gitignored).
BLOCKBUSTR_DATABASE_URL=postgres://blockbustr:change-me@postgres:5432/blockbustr?sslmode=disable
BLOCKBUSTR_REDIS_URL=redis://redis:6379/0
BLOCKBUSTR_ADMIN_USERNAME=admin
BLOCKBUSTR_ADMIN_PASSWORD=change-me   # reset on every start while set (recovery)
BLOCKBUSTR_TMDB_API_KEY=
BLOCKBUSTR_REALDEBRID_API_KEY=
BLOCKBUSTR_TORBOX_API_KEY=
# Required with a debrid key: 32 random bytes, hex or base64 (openssl rand -hex 32). Seals the keys in the database.
BLOCKBUSTR_SECRET_KEY=
# BLOCKBUSTR_EXTERNAL_URL=https://blockbustr.example.ts.net
# BLOCKBUSTR_LOG_LEVEL=debug
