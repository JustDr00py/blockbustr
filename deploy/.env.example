# blockbustr deployment settings. Copy to deploy/.env (gitignored) and run
# compose from this directory: `cd deploy && docker compose up -d`. Compose
# reads .env from the compose file's directory, so the file belongs here.

# Administrator, created on first start. While set, the password is
# re-applied on every start, which is how you recover a lost one.
BLOCKBUSTR_ADMIN_USERNAME=admin
BLOCKBUSTR_ADMIN_PASSWORD=change-me

# 32 random bytes (openssl rand -hex 32). Seals addon URLs and debrid keys in
# the database: keep a copy with your backups, a restore needs the same key.
BLOCKBUSTR_SECRET_KEY=

# Database password (used by both the postgres and blockbustr containers).
POSTGRES_PASSWORD=change-me

# Your media folder, mounted read-only at /media; config.yaml's library
# paths are inside it (/media/Movies, /media/Series…).
MEDIA_DIR=/srv/media

# Optional
BLOCKBUSTR_TMDB_API_KEY=
BLOCKBUSTR_REALDEBRID_API_KEY=
BLOCKBUSTR_TORBOX_API_KEY=
# BLOCKBUSTR_EXTERNAL_URL=https://blockbustr.example.com   # what clients reach
# BLOCKBUSTR_PORT=8096                                     # host port
# RENDER_GID=                  # Intel QSV/VAAPI: `getent group render | cut -d: -f3`
# BLOCKBUSTR_LOG_LEVEL=debug
# BLOCKBUSTR_TRANSCODE_SOFTWARE=false   # never transcode video on the CPU (hardware only)
# BLOCKBUSTR_REDIRECT_HOSTS=mfp.example.com   # apps stream from this proxy, not through blockbustr (deploy/proxy/)
